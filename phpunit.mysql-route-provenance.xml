<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/MySqlConcurrency/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache/mysql-route-provenance">
    <testsuites>
        <testsuite name="MySQL Route Provenance">
            <file>tests/MySqlConcurrency/RouteProvenanceConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="mysql_concurrency" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="MYSQL_CONCURRENCY_OCCURRENCE_MODE" value="0" force="true"/>
        <env name="MYSQL_CONCURRENCY_ROUTE_PROVENANCE_MODE" value="1" force="true"/>
        <env name="FLEET_NOTIFICATION_OCCURRENCES_ENABLED" value="false" force="true"/>
        <env name="FLEET_NOTIFICATION_AFTER_COMMIT_RECONCILIATION_ENABLED" value="false" force="true"/>
        <env name="FLEET_NOTIFICATION_SCHEDULED_RECOVERY_ENABLED" value="false" force="true"/>
        <env name="FLEET_NOTIFICATION_HISTORICAL_RECONCILIATION_ENABLED" value="false" force="true"/>
        <env name="FLEET_ROUTE_PLANNED_DEPARTURE_ENABLED" value="false" force="true"/>
        <env name="FLEET_ROUTE_PLANNED_PROOF_ISSUANCE_ENABLED" value="false" force="true"/>
        <env name="FLEET_ROUTE_PLANNED_APPLY_ENABLED" value="false" force="true"/>
        <env name="FLEET_ROUTE_PLANNED_SAVE_ENABLED" value="false" force="true"/>
        <env name="FLEET_ROUTE_PROVENANCE_RECORDING_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
