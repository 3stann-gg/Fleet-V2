# Default deny: only reviewed application/build inputs enter the context.
**
!Dockerfile
!.dockerignore
!artisan
!composer.json
!composer.lock
!package.json
!package-lock.json
!.npmrc
!vite.config.js
!postcss.config.js
!tailwind.config.js
!app/
!app/**
!bootstrap/
!bootstrap/**
!config/
!config/**
!database/
!database/**
!public/
!public/**
!resources/
!resources/**
!routes/
!routes/**

# Never copy host runtime state; Dockerfile creates writable runtime directories.
bootstrap/cache/**
public/build/**
public/hot
public/storage
public/storage/**
public/uploads
public/uploads/**
public/exports
public/exports/**

# Sensitive/local artifacts remain excluded even inside an admitted directory.
**/.env
**/.env.*
**/.envrc
**/.npmrc
!.npmrc
**/.git
**/.git/**
